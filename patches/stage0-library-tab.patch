diff --git a/frontend/apps/artcraft/app/src/pages/PageLibrary/PageLibrary.tsx b/frontend/apps/artcraft/app/src/pages/PageLibrary/PageLibrary.tsx
new file mode 100644
index 0000000..8902011
--- /dev/null
+++ b/frontend/apps/artcraft/app/src/pages/PageLibrary/PageLibrary.tsx
@@ -0,0 +1,67 @@
+import { useEffect, useState } from "react";
+import { FoldersApi, MediaFilesApi } from "@storyteller/api";
+import { authentication } from "~/signals";
+
+// Stage 0 spike: an empty Library tab that logs real account data once.
+// Throwaway — replaced by the three-panel layout in Stage 1.
+type SpikeStatus = "idle" | "loading" | "done" | "error";
+
+export const PageLibrary = () => {
+  const [status, setStatus] = useState<SpikeStatus>("idle");
+  const [summary, setSummary] = useState<string>("");
+
+  useEffect(() => {
+    const username = authentication.userInfo.value?.username;
+    if (!username) {
+      setStatus("error");
+      setSummary("Not signed in: sign in, then reopen the Library tab.");
+      return;
+    }
+
+    setStatus("loading");
+    const mediaApi = new MediaFilesApi();
+    const foldersApi = new FoldersApi();
+
+    Promise.all([
+      mediaApi.ListUserMediaFiles({ username, page_size: 24 }),
+      foldersApi.ListAllFolders(),
+      // Probe for Stage 3: this endpoint exists in libs/api but nothing calls it.
+      mediaApi.SearchUserMediaFiles({ search_term: "reaper" }),
+    ])
+      .then(([media, folders, search]) => {
+        console.group("[Library spike]");
+        console.log("ListUserMediaFiles", media);
+        console.log("first MediaFile", media.data?.[0]);
+        console.log("ListAllFolders", folders);
+        console.log("first FolderInfo", folders.data?.[0]);
+        console.log("SearchUserMediaFiles('reaper')", search);
+        console.groupEnd();
+
+        setStatus("done");
+        setSummary(
+          [
+            `media: ${media.success ? media.data?.length ?? 0 : `error: ${media.errorMessage}`}`,
+            `folders: ${folders.success ? folders.data?.length ?? 0 : `error: ${folders.errorMessage}`}`,
+            `search "reaper": ${search.success ? search.data?.length ?? 0 : `error: ${search.errorMessage}`}`,
+          ].join(" · "),
+        );
+      })
+      .catch((err: unknown) => {
+        console.error("[Library spike] failed", err);
+        setStatus("error");
+        setSummary(String(err));
+      });
+  }, []);
+
+  return (
+    <div className="flex h-full w-full flex-col items-center justify-center gap-2 pt-14 text-base-fg">
+      <h1 className="text-xl font-semibold">Library</h1>
+      <p className="text-sm opacity-70">
+        Stage 0 placeholder. Open DevTools and look for the [Library spike] group.
+      </p>
+      <p className="font-mono text-xs opacity-60" data-status={status}>
+        {status === "loading" ? "Loading…" : summary}
+      </p>
+    </div>
+  );
+};
